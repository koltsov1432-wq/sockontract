let order=[], index=0, score=0, answered=0, gradedTotal=0, locked=false, selected=new Set();
const $=id=>document.getElementById(id);
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function start(){order=shuffle(BANK.map((_,i)=>i));index=0;score=0;answered=0;gradedTotal=BANK.filter(q=>q.opts.some(o=>o.c)).length;$("quiz").classList.remove("hidden");$("result").classList.add("hidden");render()}
function render(){
 locked=false;selected.clear();const q=BANK[order[index]];
 $("progressText").textContent=`Вопрос ${index+1} из ${BANK.length}`;$("scoreText").textContent=`Верно: ${score}`;
 $("bar").style.width=`${index/BANK.length*100}%`;$("qnum").textContent=`ВОПРОС №${q.n}`;$("question").textContent=q.q;
 $("answers").innerHTML="";$("feedback").className="feedback hidden";
 const multi=q.opts.filter(o=>o.c).length>1;
 q.opts.forEach((o,i)=>{const label=document.createElement("label");label.className="option";label.innerHTML=`<input type="${multi?'checkbox':'radio'}" name="answer" value="${i}"><span><b>${i+1}.</b> ${escapeHtml(o.t)}</span>`;label.addEventListener("click",()=>{if(locked)return;const input=label.querySelector("input");if(multi){if(selected.has(i))selected.delete(i);else selected.add(i)}else selected=new Set([i]);document.querySelectorAll(".option").forEach((el,j)=>el.classList.toggle("selected",selected.has(j)));});$("answers").appendChild(label)});
 $("check").classList.remove("hidden");$("next").classList.add("hidden");$("skip").disabled=false;
}
function escapeHtml(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function check(){
 if(!selected.size)return;
 const q=BANK[order[index]], correct=q.opts.map((o,i)=>o.c?i:-1).filter(i=>i>=0);
 locked=true;answered++;
 const known=correct.length>0;
 const isCorrect=known&&correct.length===selected.size&&correct.every(i=>selected.has(i));
 if(known){if(isCorrect)score++;}
 document.querySelectorAll(".option").forEach((el,i)=>{el.querySelector("input").disabled=true;if(correct.includes(i))el.classList.add("correct");else if(selected.has(i))el.classList.add("wrong")});
 const fb=$("feedback");fb.classList.remove("hidden");
 if(!known){fb.className="feedback neutral";fb.textContent="В исходном PDF правильный вариант не выделен. Этот вопрос не учитывается в баллах."}
 else if(isCorrect){fb.className="feedback good";fb.textContent="Правильно! Отличный ответ."}
 else{fb.className="feedback bad";fb.textContent="Неправильно. Правильный ответ: "+correct.map(i=>(i+1)+". "+q.opts[i].t).join(" / ")}
 $("scoreText").textContent=`Верно: ${score}`;$("check").classList.add("hidden");$("next").classList.remove("hidden");$("skip").disabled=true;
}
function next(){if(index<BANK.length-1){index++;render()}else finish()}
function finish(){
 $("quiz").classList.add("hidden");$("result").classList.remove("hidden");
 const pct=gradedTotal?Math.round(score/gradedTotal*100):0;
 $("finalScore").textContent=`${score} / ${gradedTotal}`;
 $("finalTitle").textContent=pct>=90?"Отличный результат!":pct>=70?"Хороший результат!":pct>=50?"Есть над чем поработать":"Попробуй ещё раз";
 $("finalDetail").textContent=`Правильных ответов: ${score} из ${gradedTotal} вопросов с отмеченным ответом (${pct}%). Всего пройдено: ${BANK.length}.`;
 $("bar").style.width="100%";
}
$("check").addEventListener("click",check);$("next").addEventListener("click",next);$("skip").addEventListener("click",()=>{if(index<BANK.length-1){index++;render()}else finish()});$("restart").addEventListener("click",start);
start();
</script>
